# Mantém todos os arquivos de texto com quebra de linha LF (padrão da web)
* text=auto eol=lf

# Imagens e fontes são binários (nunca converter)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Fonte de terceiros: arquivos guardados exatamente como o autor distribuiu (sem conversão de linhas)
assets/fonts/8-bit-wonder/** -text
